# SMTP credentials used by app/api/bookings/route.ts to email the shop owner
# (atelierkharita@gmail.com) whenever a new booking comes in. Without these set,
# bookings still save locally — the app just skips sending the email and logs a warning.
#
# Since the owner's inbox is Gmail, the simplest option is sending through Gmail
# itself: enable 2-Step Verification on atelierkharita@gmail.com, then create an
# App Password at https://myaccount.google.com/apppasswords and use it below.
#   EMAIL_SMTP_HOST=smtp.gmail.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_USER=atelierkharita@gmail.com
#   EMAIL_SMTP_PASS=<16-character app password>
#   EMAIL_FROM=atelierkharita@gmail.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# Required for the /admin dashboard (sign-in, prices, images, orders).
# ADMIN_PASSWORD is the login password for the shop owner — pick something strong,
# this is the only thing standing between the public internet and your bookings/prices.
# ADMIN_SESSION_SECRET signs the login session cookie — any long random string,
# e.g. generate one with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
